# Copy this file to .env (in the repository root) and fill in your paths.
# .env is ignored by git; never commit it, because it holds your W&B key.
# The code reads it with python-dotenv. On the EIDF cluster the launcher
# (launch/run.tpl.yml) sets these variables instead, so pods don't use .env.
# Lines starting with # are switched off.

# --- Needed for most things --------------------------------------------------

# Folder holding the datasets. Must end with "/".
# Expected inside: Emojis/, 260726_nca_dataset/, snowmelt/, ...
# (see docs/data.md). On EIDF pods: /workspace/writeable/Data/
DATA_PATH_BASE="/path/to/Data/"

# Folder holding trained models (bundles/, impulses/, registry.sqlite).
# Defaults to models/ in the repository. On EIDF pods: /workspace/writeable/Models/
MODEL_STORE_ROOT="/path/to/Differentiable-Patterning/models/"

# Weights & Biases login (https://wandb.ai/authorize). Or run `wandb login` once
# instead, or set logging.backend: none in a config to train without W&B.
WANDB_API_KEY=""

# --- Optional -----------------------------------------------------------------

# W&B team or user that runs are logged to (some notebooks read it).
# WANDB_ENTITY=""

# Set to "offline" to log W&B runs locally and upload later with `wandb sync`.
# WANDB_MODE="offline"

# Local cache of cleaned 260726 micropattern images, to speed up notebooks.
# Leave unset on the cluster.
# DATA_CACHE_DIR="/path/to/Data/cache/"

# Snowmelt data root. Defaults to $DATA_PATH_BASE/snowmelt
# SNOWMELT_DATA_ROOT=""

# Stored Cellpose nucleus segmentation. Defaults to
# $DATA_PATH_BASE/260726_nca_segmentation
# NUCLEUS_SEGMENTATION_ROOT=""

# One 3D image stack, used only by the imaging schematic figure notebook.
# MICROPATTERN_3D_STACK="/path/to/Data/micropattern_3d_example/B3_F4_48h.ome.tiff"

# Root folder for some older outputs (thesis notebooks, smoke tests).
# Usually the repository root, ending with "/". On EIDF pods: /workspace
# PVC_PATH="/path/to/Differentiable-Patterning/"
